<mxCell id="edge-ec2-1c-to-aurora-1c" value="読み取り" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=left;spacingLeft=6;exitX=0.75;exitY=1;exitDx=0;exitDy=24;exitPerimeter=0;entryX=0.75;entryY=0" edge="1" parent="1" source="ec2-1c" target="aurora-1c"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="edge-ec2-1c-to-s3" value="読み書き&#xa;（VPC エンドポイント経由）&#xa;（全 AZ から）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="ec2-1c" target="s3"><mxGeometry x="0.472" relative="1" as="geometry"><Array as="points"><mxPoint x="828" y="318" /></Array></mxGeometry></mxCell>
