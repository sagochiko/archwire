<mxfile archwire="0.1.0" rules="2026.11.13"><diagram id="p1" name="Architecture"><mxGraphModel adaptiveColors="auto"><root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS のリソースは AWS Cloud の枠の中に描く。" rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1090" height="661" as="geometry" /></mxCell></object>
<object id="region" label="東京リージョン（ap-northeast-1）" added="1" derived="リージョンに属する AWS のリソースは、そのリージョンの枠の中に描く。 | リージョンの指定が無いので、ap-northeast-1（東京）にする。" rule="resources-inside-region-frame | default-region" kind="default | default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="30" y="50" width="1030" height="581" as="geometry" /></mxCell></object>
<object id="vpc" label="VPC" added="1" derived="Amazon EC2 のインスタンスはサブネットに起動され、そのサブネットに関連付けられたアベイラビリティゾーンで動くので、VPC を描く。" rule="ec2-instance-in-subnet" kind="constraint" source="https://aws.amazon.com/vpc/faqs/"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="region"><mxGeometry x="30" y="45" width="728" height="496" as="geometry" /></mxCell></object>
<object id="az-1a" label="ap-northeast-1a" added="1" derived="AZ の数の指定が無いので、2つにする。" rule="default-two-azs-for-instances" kind="default"><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="30" y="33" width="324" height="443" as="geometry" /></mxCell></object>
<object id="pri-1a" label="プライベートサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにプライベートサブネットを1つ置く。パブリックサブネットに置く部品は無い。" rule="private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="20" y="50" width="284" height="378" as="geometry" /></mxCell></object>
<object id="az-1c" label="ap-northeast-1c" added="1" derived="AZ の数の指定が無いので、2つにする。" rule="default-two-azs-for-instances" kind="default"><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="374" y="33" width="324" height="443" as="geometry" /></mxCell></object>
<object id="pri-1c" label="プライベートサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにプライベートサブネットを1つ置く。パブリックサブネットに置く部品は無い。" rule="private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="20" y="50" width="284" height="378" as="geometry" /></mxCell></object>
<object id="ec2-1a" label="Amazon EC2" derived="サブネットの指定が無いので、EC2 のインスタンスは、インターネットから届かないプライベートサブネットに置く。archwire は、各アベイラビリティゾーンのプライベートサブネットに1つずつ描く。" rule="instances-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2" vertex="1" parent="pri-1a"><mxGeometry x="112" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ec2-1c" label="Amazon EC2" derived="サブネットの指定が無いので、EC2 のインスタンスは、インターネットから届かないプライベートサブネットに置く。archwire は、各アベイラビリティゾーンのプライベートサブネットに1つずつ描く。" rule="instances-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2" vertex="1" parent="pri-1c"><mxGeometry x="112" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1a" label="Amazon Aurora&#xa;Writer" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1a"><mxGeometry x="112" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1c" label="Amazon Aurora&#xa;Reader" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1c"><mxGeometry x="112" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3" label="Amazon S3" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="918" y="178" width="60" height="60" as="geometry" /></mxCell></object>
