<object id="cognito" label="Amazon Cognito" derived="Amazon Cognito user pools are each created in one AWS Region. archwire draws the user pool inside the Region frame." rule="cognito-user-pool-in-one-region" kind="constraint" source="https://docs.aws.amazon.com/cognito/latest/developerguide/security-cognito-regional-data-considerations.html"><mxCell style="fontColor=#16191F;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito" vertex="1" parent="region"><mxGeometry x="148" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3" label="Amazon S3" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame." rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="368" y="60" width="60" height="60" as="geometry" /></mxCell></object>
