<object id="cloudfront" label="Amazon CloudFront" derived="AWS は Amazon CloudFront と AWS WAF for CloudFront を、リソースがリージョンに属さないグローバルサービスに挙げている。archwire はグローバルサービスを AWS Cloud の枠の中、リージョンの枠の外に描く。" rule="global-service-outside-region" kind="default" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront" vertex="1" parent="aws-cloud"><mxGeometry x="80" y="208" width="60" height="60" as="geometry" /></mxCell></object>
<object id="igw" label="Internet Gateway" added="1" derived="インターネット向けの Application Load Balancer では、Internet Gateway のある VPC しか選べないので、VPC に Internet Gateway を置く。" rule="internet-facing-alb-in-vpc-with-igw" kind="constraint" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/create-application-load-balancer.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.internet_gateway" vertex="1" parent="vpc"><mxGeometry x="39" y="113" width="60" height="60" as="geometry" /></mxCell></object>
<object id="alb" label="Application Load Balancer"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing" vertex="1" parent="vpc"><mxGeometry x="621" y="113" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1a" label="Amazon ECS（Fargate）" derived="サブネットの指定が無いので、ECS はプライベートサブネットに置く。外からの通信はロードバランサーが受ける。" rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate" vertex="1" parent="pri-1a"><mxGeometry x="141" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1c" label="Amazon ECS（Fargate）" derived="サブネットの指定が無いので、ECS はプライベートサブネットに置く。外からの通信はロードバランサーが受ける。" rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate" vertex="1" parent="pri-1c"><mxGeometry x="141" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1a" label="Amazon Aurora&#xa;Writer" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1a"><mxGeometry x="141" y="448" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1c" label="Amazon Aurora&#xa;Reader" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1c"><mxGeometry x="141" y="448" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda.api@1a" label="AWS Lambda&#xa;api" derived="Lambda 関数は、リソースを含むプライベートサブネットを通じて VPC にアタッチすると、Amazon VPC 内のリソースにアクセスできる。archwire は、VPC の中の部品につなぐ関数を、その VPC のプライベートサブネットに描く。 | Lambda 関数はどれも、Lambda が所有し管理する VPC の中で動く。関数を VPC にアタッチすると、選んだサブネットとセキュリティグループの組み合わせに対して Lambda が作るネットワークインターフェイスを使う。archwire は、アタッチした関数を、各アベイラビリティゾーンのプライベートサブネットに1つずつ描く。" rule="function-attaches-to-resource-vpc | attached-function-per-az" kind="constraint | default" source="https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="pri-1a"><mxGeometry x="341" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda.api@1c" label="AWS Lambda&#xa;api" derived="Lambda 関数は、リソースを含むプライベートサブネットを通じて VPC にアタッチすると、Amazon VPC 内のリソースにアクセスできる。archwire は、VPC の中の部品につなぐ関数を、その VPC のプライベートサブネットに描く。 | Lambda 関数はどれも、Lambda が所有し管理する VPC の中で動く。関数を VPC にアタッチすると、選んだサブネットとセキュリティグループの組み合わせに対して Lambda が作るネットワークインターフェイスを使う。archwire は、アタッチした関数を、各アベイラビリティゾーンのプライベートサブネットに1つずつ描く。" rule="function-attaches-to-resource-vpc | attached-function-per-az" kind="constraint | default" source="https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="pri-1c"><mxGeometry x="341" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3" label="Amazon S3" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="110" y="277" width="60" height="60" as="geometry" /></mxCell></object>
<object id="dynamodb" label="Amazon DynamoDB" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb" vertex="1" parent="region"><mxGeometry x="2057" y="782" width="60" height="60" as="geometry" /></mxCell></object>
