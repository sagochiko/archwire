<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS resources are drawn inside the AWS Cloud frame." rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="160" y="60" width="498" height="424" as="geometry" /></mxCell></object>
<object id="region" label="Tokyo (ap-northeast-1)" added="1" derived="AWS resources that belong to a Region are drawn inside that Region's frame. | No Region was given, so ap-northeast-1 (Tokyo) is used." rule="resources-inside-region-frame | default-region" kind="default | default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="246" y="50" width="222" height="184" as="geometry" /></mxCell></object>
<object id="user" label="Users"><mxCell style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users" vertex="1" parent="1"><mxGeometry x="40" y="170" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudfront" label="Amazon CloudFront" derived="AWS lists Amazon CloudFront, Amazon Route 53 and AWS WAF for CloudFront among the global services, whose resources are not Region-specific. archwire draws global services inside the AWS Cloud frame and outside the Region frame." rule="global-service-outside-region" kind="default" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront" vertex="1" parent="aws-cloud"><mxGeometry x="80" y="110" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3" label="Amazon S3" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame." rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="110" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="route53" label="Amazon Route 53" derived="AWS lists Amazon CloudFront, Amazon Route 53 and AWS WAF for CloudFront among the global services, whose resources are not Region-specific. archwire draws global services inside the AWS Cloud frame and outside the Region frame." rule="global-service-outside-region" kind="default" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53" vertex="1" parent="aws-cloud"><mxGeometry x="80" y="270" width="60" height="60" as="geometry" /></mxCell></object>
