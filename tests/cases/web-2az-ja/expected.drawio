<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS のリソースは AWS Cloud の枠の中に描く。" rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1200" height="1015" as="geometry" /></mxCell></object>
<object id="region" label="東京リージョン（ap-northeast-1）" added="1" derived="リージョンの指定が無いので、ap-northeast-1（東京）にする。" rule="default-region" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="30" y="160" width="1140" height="830" as="geometry" /></mxCell></object>
<object id="vpc" label="VPC" added="1" derived="Application Load Balancer は VPC のサブネットに作るので、VPC を描く。" rule="load-balancer-in-vpc" kind="constraint" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/create-application-load-balancer.html"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="region"><mxGeometry x="30" y="40" width="860" height="765" as="geometry" /></mxCell></object>
<object id="az-1a" label="ap-northeast-1a" added="1" derived="Application Load Balancer には、2つ以上のアベイラビリティゾーンのサブネットが要る。 | AZ の数の指定が無いので、Application Load Balancer が受け付ける最小の2つにする。" rule="alb-spans-two-azs | default-two-azs" kind="constraint | default" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/application-load-balancers.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="30" y="150" width="390" height="595" as="geometry" /></mxCell></object>
<object id="pub-1a" label="パブリックサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="30" y="30" width="350" height="150" as="geometry" /></mxCell></object>
<object id="pri-1a" label="プライベートサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="30" y="200" width="350" height="380" as="geometry" /></mxCell></object>
<object id="az-1c" label="ap-northeast-1c" added="1" derived="Application Load Balancer には、2つ以上のアベイラビリティゾーンのサブネットが要る。 | AZ の数の指定が無いので、Application Load Balancer が受け付ける最小の2つにする。" rule="alb-spans-two-azs | default-two-azs" kind="constraint | default" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/application-load-balancers.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="440" y="150" width="390" height="595" as="geometry" /></mxCell></object>
<object id="pub-1c" label="パブリックサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="10" y="30" width="350" height="150" as="geometry" /></mxCell></object>
<object id="pri-1c" label="プライベートサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="10" y="200" width="350" height="380" as="geometry" /></mxCell></object>
<object id="user" label="利用者"><mxCell style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users" vertex="1" parent="1"><mxGeometry x="500" y="20" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudfront" label="Amazon CloudFront" derived="AWS は Amazon CloudFront と AWS WAF for CloudFront を、リソースがリージョンに属さないグローバルサービスに挙げている。archwire はグローバルサービスを AWS Cloud の枠の中、リージョンの枠の外に描く。" rule="global-service-outside-region" kind="constraint" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront" vertex="1" parent="aws-cloud"><mxGeometry x="460" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="igw" label="Internet Gateway" added="1" derived="インターネット向けの Application Load Balancer では、Internet Gateway のある VPC しか選べないので、VPC に Internet Gateway を置く。" rule="internet-facing-alb-in-vpc-with-igw" kind="constraint" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/create-application-load-balancer.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.internet_gateway" vertex="1" parent="vpc"><mxGeometry x="400" y="30" width="60" height="60" as="geometry" /></mxCell></object>
<object id="alb" label="Application Load Balancer"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing" vertex="1" parent="vpc"><mxGeometry x="400" y="220" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1a" label="NAT Gateway" added="1" derived="プライベートサブネットのリソースは、パブリックサブネットに作った NAT Gateway を通してインターネットへ接続する。 | NAT Gateway をアベイラビリティゾーンごとに置くと、ほかのゾーンが止まっても外向きの通信が続く。" rule="private-egress-through-nat | nat-per-az" kind="constraint | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat-gateway.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1a"><mxGeometry x="20" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1c" label="NAT Gateway" added="1" derived="プライベートサブネットのリソースは、パブリックサブネットに作った NAT Gateway を通してインターネットへ接続する。 | NAT Gateway をアベイラビリティゾーンごとに置くと、ほかのゾーンが止まっても外向きの通信が続く。" rule="private-egress-through-nat | nat-per-az" kind="constraint | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat-gateway.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1c"><mxGeometry x="270" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1a" label="Amazon ECS（Fargate）" derived="サブネットの指定が無いので、ECS はプライベートサブネットに置く。外からの通信はロードバランサーが受ける。" rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate" vertex="1" parent="pri-1a"><mxGeometry x="145" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1c" label="Amazon ECS（Fargate）" derived="サブネットの指定が無いので、ECS はプライベートサブネットに置く。外からの通信はロードバランサーが受ける。" rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate" vertex="1" parent="pri-1c"><mxGeometry x="145" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1a" label="Amazon Aurora&#xa;Writer" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1a"><mxGeometry x="145" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1c" label="Amazon Aurora&#xa;Reader" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1c"><mxGeometry x="145" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3" label="Amazon S3" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="1030" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudwatch" label="Amazon CloudWatch" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2" vertex="1" parent="region"><mxGeometry x="1030" y="440" width="60" height="60" as="geometry" /></mxCell></object>
