  "derived": [
    {
      "target": "aws-cloud",
      "added": true,
      "kind": "default",
      "rule": "resources-inside-aws-cloud-frame",
      "reason": "AWS のリソースは AWS Cloud の枠の中に描く。",
      "source": null
    },
    {
      "target": "region",
      "added": true,
      "kind": "default",
      "rule": "resources-inside-region-frame",
      "reason": "リージョンに属する AWS のリソースは、そのリージョンの枠の中に描く。",
      "source": null
    },
    {
      "target": "region",
      "added": true,
      "kind": "default",
      "rule": "default-region",
      "reason": "リージョンの指定が無いので、ap-northeast-1（東京）にする。",
      "source": null
    },
    {
      "target": "vpc",
      "added": true,
      "kind": "constraint",
      "rule": "aurora-cluster-in-vpc",
      "reason": "Amazon Aurora の DB クラスターは VPC の中にだけ作成できるので、VPC を描く。",
      "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html"
    },
    {
      "target": "az",
      "added": true,
      "kind": "constraint",
      "rule": "aurora-subnet-group-two-azs",
      "reason": "Aurora の DB クラスターに選ぶ DB サブネットグループは、少なくとも2つのアベイラビリティゾーンを覆わなければならない。archwire は、2つ以上のアベイラビリティゾーンを描く。",
      "source": "https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html"
    },
    {
      "target": "subnet",
      "added": true,
      "kind": "default",
      "rule": "private-subnet-per-az",
      "reason": "archwire は、各アベイラビリティゾーンにプライベートサブネットを1つ置く。パブリックサブネットに置く部品は無い。",
      "source": null
    },
    {
      "target": "apigateway",
      "added": false,
      "kind": "default",
      "rule": "regional-service-outside-vpc",
      "reason": "VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。",
      "source": null
    },
    {
      "target": "lambda",
      "added": false,
      "kind": "constraint",
      "rule": "function-attaches-to-resource-vpc",
      "reason": "Lambda 関数は、リソースを含むプライベートサブネットを通じて VPC にアタッチすると、Amazon VPC 内のリソースにアクセスできる。archwire は、VPC の中の部品につなぐ関数を、その VPC のプライベートサブネットに描く。",
      "source": "https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html"
    },
    {
      "target": "lambda",
      "added": false,
      "kind": "default",
      "rule": "attached-function-per-az",
      "reason": "Lambda 関数はどれも、Lambda が所有し管理する VPC の中で動く。関数を VPC にアタッチすると、選んだサブネットとセキュリティグループの組み合わせに対して Lambda が作るネットワークインターフェイスを使う。archwire は、アタッチした関数を、各アベイラビリティゾーンのプライベートサブネットに1つずつ描く。",
      "source": "https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html"
    },
    {
      "target": "aurora",
      "added": false,
      "kind": "default",
      "rule": "database-in-private",
      "reason": "サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。",
