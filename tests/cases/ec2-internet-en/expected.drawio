<mxfile archwire="0.1.0" rules="2026.11.8"><diagram id="p1" name="Architecture"><mxGraphModel adaptiveColors="auto"><root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS resources are drawn inside the AWS Cloud frame." rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="40" y="60" width="900" height="715" as="geometry" /></mxCell></object>
<object id="region" label="Tokyo (ap-northeast-1)" added="1" derived="AWS resources that belong to a Region are drawn inside that Region's frame. | No Region was given, so ap-northeast-1 (Tokyo) is used." rule="resources-inside-region-frame | default-region" kind="default | default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="30" y="50" width="840" height="635" as="geometry" /></mxCell></object>
<object id="vpc" label="VPC" added="1" derived="An Amazon EC2 instance is launched in a subnet, in the Availability Zone associated with that subnet, so a VPC is drawn." rule="ec2-instance-in-subnet" kind="constraint" source="https://aws.amazon.com/vpc/faqs/"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="region"><mxGeometry x="30" y="45" width="760" height="550" as="geometry" /></mxCell></object>
<object id="az-1a" label="ap-northeast-1a" added="1" derived="No number of Availability Zones was given, so two are used." rule="default-two-azs-for-instances" kind="default"><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="30" y="157" width="340" height="373" as="geometry" /></mxCell></object>
<object id="pub-1a" label="Public subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="20" y="30" width="300" height="154" as="geometry" /></mxCell></object>
<object id="pri-1a" label="Private subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="20" y="204" width="300" height="154" as="geometry" /></mxCell></object>
<object id="az-1c" label="ap-northeast-1c" added="1" derived="No number of Availability Zones was given, so two are used." rule="default-two-azs-for-instances" kind="default"><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="390" y="157" width="340" height="373" as="geometry" /></mxCell></object>
<object id="pub-1c" label="Public subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="20" y="30" width="300" height="154" as="geometry" /></mxCell></object>
<object id="pri-1c" label="Private subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="20" y="204" width="300" height="154" as="geometry" /></mxCell></object>
<object id="igw" label="Internet Gateway" added="1" derived="Resources in a private subnet can connect to the internet through a NAT device in a public subnet, which replaces their source IPv4 addresses with its own." rule="private-egress-through-nat" kind="constraint" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.internet_gateway" vertex="1" parent="vpc"><mxGeometry x="350" y="33" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1a" label="NAT Gateway" added="1" derived="Resources in a private subnet can connect to the internet through a NAT device in a public subnet, which replaces their source IPv4 addresses with its own. | You can use the managed NAT device AWS offers, the NAT gateway, or build your own NAT device on EC2, a NAT instance; AWS recommends NAT gateways for better availability and bandwidth and less administration. archwire draws a NAT gateway. | One NAT gateway per Availability Zone keeps outbound traffic working when another zone fails." rule="private-egress-through-nat | nat-device-is-nat-gateway | nat-per-az" kind="constraint | default | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1a"><mxGeometry x="210" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1c" label="NAT Gateway" added="1" derived="Resources in a private subnet can connect to the internet through a NAT device in a public subnet, which replaces their source IPv4 addresses with its own. | You can use the managed NAT device AWS offers, the NAT gateway, or build your own NAT device on EC2, a NAT instance; AWS recommends NAT gateways for better availability and bandwidth and less administration. archwire draws a NAT gateway. | One NAT gateway per Availability Zone keeps outbound traffic working when another zone fails." rule="private-egress-through-nat | nat-device-is-nat-gateway | nat-per-az" kind="constraint | default | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1c"><mxGeometry x="210" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ec2-1a" label="Amazon EC2" derived="No subnet was given, so the EC2 instances are placed in private subnets, which are not reachable from the internet. archwire draws one in the private subnet of each Availability Zone." rule="instances-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2" vertex="1" parent="pri-1a"><mxGeometry x="90" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ec2-1c" label="Amazon EC2" derived="No subnet was given, so the EC2 instances are placed in private subnets, which are not reachable from the internet. archwire draws one in the private subnet of each Availability Zone." rule="instances-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2" vertex="1" parent="pri-1c"><mxGeometry x="90" y="50" width="60" height="60" as="geometry" /></mxCell></object>
