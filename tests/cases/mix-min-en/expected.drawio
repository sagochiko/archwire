<mxfile archwire="0.1.0" rules="2026.11.13"><diagram id="p1" name="Architecture"><mxGraphModel adaptiveColors="auto"><root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS resources are drawn inside the AWS Cloud frame." rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="40" y="177" width="666" height="896" as="geometry" /></mxCell></object>
<object id="region" label="Tokyo (ap-northeast-1)" added="1" derived="AWS resources that belong to a Region are drawn inside that Region's frame. | No Region was given, so ap-northeast-1 (Tokyo) is used." rule="resources-inside-region-frame | default-region" kind="default | default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="30" y="50" width="606" height="816" as="geometry" /></mxCell></object>
<object id="vpc" label="VPC" added="1" derived="An Amazon Aurora DB cluster can be created only in a VPC, so a VPC is drawn." rule="aurora-cluster-in-vpc" kind="constraint" source="https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="region"><mxGeometry x="30" y="280" width="526" height="496" as="geometry" /></mxCell></object>
<object id="az-1a" label="ap-northeast-1a" added="1" derived="The DB subnet group chosen for an Aurora DB cluster must cover at least two Availability Zones. archwire draws at least two Availability Zones. | No number of Availability Zones was given, so two are used." rule="aurora-subnet-group-two-azs | default-two-azs-for-database" kind="constraint | default" source="https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="30" y="33" width="223" height="443" as="geometry" /></mxCell></object>
<object id="pri-1a" label="Private subnet" added="1" derived="archwire gives each Availability Zone one private subnet; no part here is placed in a public subnet." rule="private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="20" y="50" width="183" height="378" as="geometry" /></mxCell></object>
<object id="az-1c" label="ap-northeast-1c" added="1" derived="The DB subnet group chosen for an Aurora DB cluster must cover at least two Availability Zones. archwire draws at least two Availability Zones. | No number of Availability Zones was given, so two are used." rule="aurora-subnet-group-two-azs | default-two-azs-for-database" kind="constraint | default" source="https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="273" y="33" width="223" height="443" as="geometry" /></mxCell></object>
<object id="pri-1c" label="Private subnet" added="1" derived="archwire gives each Availability Zone one private subnet; no part here is placed in a public subnet." rule="private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="20" y="50" width="183" height="378" as="geometry" /></mxCell></object>
<object id="user" label="Users"><mxCell style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users" vertex="1" parent="1"><mxGeometry x="362" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda-1a" label="AWS Lambda" derived="A Lambda function can be given access to resources in an Amazon VPC by attaching it to the VPC through the private subnets that contain the resources. archwire draws a function that connects to a part in a VPC in that VPC's private subnets. | Every Lambda function runs inside a VPC that Lambda owns and manages; attaching a function to a VPC gives it a network interface that Lambda creates for the chosen subnet and security group combination. archwire draws the attached function once in the private subnet of each Availability Zone." rule="function-attaches-to-resource-vpc | attached-function-per-az" kind="constraint | default" source="https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="pri-1a"><mxGeometry x="90" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda-1c" label="AWS Lambda" derived="A Lambda function can be given access to resources in an Amazon VPC by attaching it to the VPC through the private subnets that contain the resources. archwire draws a function that connects to a part in a VPC in that VPC's private subnets. | Every Lambda function runs inside a VPC that Lambda owns and manages; attaching a function to a VPC gives it a network interface that Lambda creates for the chosen subnet and security group combination. archwire draws the attached function once in the private subnet of each Availability Zone." rule="function-attaches-to-resource-vpc | attached-function-per-az" kind="constraint | default" source="https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="pri-1c"><mxGeometry x="90" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1a" label="Amazon Aurora&#xa;Writer" derived="No subnet was given, so Aurora is placed in private subnets so it is not reachable from the internet. | The Writer goes in the first Availability Zone and Readers in the remaining ones." rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1a"><mxGeometry x="90" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1c" label="Amazon Aurora&#xa;Reader" derived="No subnet was given, so Aurora is placed in private subnets so it is not reachable from the internet. | The Writer goes in the first Availability Zone and Readers in the remaining ones." rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1c"><mxGeometry x="90" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="apigateway" label="Amazon API Gateway&#xa;HTTP API" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame." rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway" vertex="1" parent="region"><mxGeometry x="292" y="60" width="60" height="60" as="geometry" /></mxCell></object>
