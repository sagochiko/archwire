<mxCell id="edge-alb-to-ecs-1c" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=left;spacingLeft=6;exitX=0.75;exitY=1;exitDx=0;exitDy=24;exitPerimeter=0;entryX=0.5;entryY=0" edge="1" parent="1" source="alb" target="ecs-1c"><mxGeometry x="0.768" relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="670" /><mxPoint x="725" y="670" /></Array></mxGeometry></mxCell>
