<mxfile archwire="0.1.0" rules="2026.11.1"><diagram id="p1" name="Architecture"><mxGraphModel adaptiveColors="auto"><root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS resources are drawn inside the AWS Cloud frame." rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1200" height="805" as="geometry" /></mxCell></object>
<object id="region" label="Tokyo (ap-northeast-1)" added="1" derived="No Region was given, so ap-northeast-1 (Tokyo) is used." rule="default-region" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="30" y="160" width="1140" height="620" as="geometry" /></mxCell></object>
<object id="vpc" label="VPC" added="1" derived="An Application Load Balancer is created in subnets of a VPC, so a VPC is drawn." rule="load-balancer-in-vpc" kind="constraint" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/create-application-load-balancer.html"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="region"><mxGeometry x="30" y="40" width="860" height="555" as="geometry" /></mxCell></object>
<object id="az-1a" label="ap-northeast-1a" added="1" derived="An Application Load Balancer requires subnets in at least two Availability Zones. | No number of Availability Zones was given, so two are used, the minimum an Application Load Balancer accepts." rule="alb-spans-two-azs | default-two-azs" kind="constraint | default" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/application-load-balancers.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="30" y="150" width="390" height="385" as="geometry" /></mxCell></object>
<object id="pub-1a" label="Public subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="30" y="30" width="350" height="150" as="geometry" /></mxCell></object>
<object id="pri-1a" label="Private subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="30" y="200" width="350" height="170" as="geometry" /></mxCell></object>
<object id="az-1c" label="ap-northeast-1c" added="1" derived="An Application Load Balancer requires subnets in at least two Availability Zones. | No number of Availability Zones was given, so two are used, the minimum an Application Load Balancer accepts." rule="alb-spans-two-azs | default-two-azs" kind="constraint | default" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/application-load-balancers.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="440" y="150" width="390" height="385" as="geometry" /></mxCell></object>
<object id="pub-1c" label="Public subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="10" y="30" width="350" height="150" as="geometry" /></mxCell></object>
<object id="pri-1c" label="Private subnet" added="1" derived="archwire gives each Availability Zone one public subnet and one private subnet." rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="10" y="200" width="350" height="170" as="geometry" /></mxCell></object>
<object id="user" label="Users"><mxCell style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users" vertex="1" parent="1"><mxGeometry x="500" y="20" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudfront" label="Amazon CloudFront" derived="AWS lists Amazon CloudFront and AWS WAF for CloudFront among the global services, whose resources are not Region-specific. archwire draws global services inside the AWS Cloud frame and outside the Region frame." rule="global-service-outside-region" kind="constraint" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront" vertex="1" parent="aws-cloud"><mxGeometry x="460" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="waf" label="AWS WAF" derived="AWS lists Amazon CloudFront and AWS WAF for CloudFront among the global services, whose resources are not Region-specific. archwire draws global services inside the AWS Cloud frame and outside the Region frame." rule="global-service-outside-region" kind="constraint" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf" vertex="1" parent="aws-cloud"><mxGeometry x="260" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="acm" label="AWS Certificate Manager&#xa;us-east-1" derived="To use an AWS Certificate Manager certificate with a CloudFront distribution, the certificate is requested or imported in US East (N. Virginia) (us-east-1). archwire draws it outside the Region frame and writes us-east-1 under its name." rule="cloudfront-certificate-in-us-east-1" kind="constraint" source="https://docs.aws.amazon.com/AmazonCloudFront/latest/DeveloperGuide/cnames-and-https-requirements.html"><mxCell style="fontColor=#16191F;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3" vertex="1" parent="aws-cloud"><mxGeometry x="660" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="igw" label="Internet Gateway" added="1" derived="With an internet-facing Application Load Balancer, only VPCs that have an Internet Gateway can be selected, so the VPC gets an Internet Gateway." rule="internet-facing-alb-in-vpc-with-igw" kind="constraint" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/create-application-load-balancer.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.internet_gateway" vertex="1" parent="vpc"><mxGeometry x="400" y="30" width="60" height="60" as="geometry" /></mxCell></object>
<object id="alb" label="Application Load Balancer"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing" vertex="1" parent="vpc"><mxGeometry x="400" y="220" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1a" label="Amazon ECS" derived="No subnet was given, so ECS is placed in private subnets; traffic reaches it through the load balancer." rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs" vertex="1" parent="pri-1a"><mxGeometry x="145" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1c" label="Amazon ECS" derived="No subnet was given, so ECS is placed in private subnets; traffic reaches it through the load balancer." rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs" vertex="1" parent="pri-1c"><mxGeometry x="145" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<mxCell id="edge-user-to-cloudfront" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=left;spacingLeft=6;exitX=0.5;exitY=1;exitDx=0;exitDy=24;exitPerimeter=0;entryX=0.5;entryY=0" edge="1" parent="1" source="user" target="cloudfront"><mxGeometry x="0.364" relative="1" as="geometry" /></mxCell>
