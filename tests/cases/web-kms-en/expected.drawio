<object id="cloudfront" label="Amazon CloudFront" derived="AWS lists Amazon CloudFront, Amazon Route 53 and AWS WAF for CloudFront among the global services, whose resources are not Region-specific. archwire draws global services inside the AWS Cloud frame and outside the Region frame." rule="global-service-outside-region" kind="default" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront" vertex="1" parent="aws-cloud"><mxGeometry x="467" y="45" width="60" height="60" as="geometry" /></mxCell></object>
<object id="igw" label="Internet Gateway" added="1" derived="With an internet-facing Application Load Balancer, only VPCs that have an Internet Gateway can be selected, so the VPC gets an Internet Gateway." rule="internet-facing-alb-in-vpc-with-igw" kind="constraint" source="https://docs.aws.amazon.com/elasticloadbalancing/latest/application/create-application-load-balancer.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.internet_gateway" vertex="1" parent="vpc"><mxGeometry x="407" y="33" width="60" height="60" as="geometry" /></mxCell></object>
<object id="alb" label="Application Load Balancer"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing" vertex="1" parent="vpc"><mxGeometry x="407" y="237" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1a" label="NAT Gateway" added="1" derived="Resources in a private subnet can connect to the internet through a NAT device in a public subnet, which replaces their source IPv4 addresses with its own. | You can use the managed NAT device AWS offers, the NAT gateway, or build your own NAT device on EC2, a NAT instance; AWS recommends NAT gateways for better availability and bandwidth and less administration. archwire draws a NAT gateway. | One NAT gateway per Availability Zone keeps outbound traffic working when another zone fails." rule="private-egress-through-nat | nat-device-is-nat-gateway | nat-per-az" kind="constraint | default | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1a"><mxGeometry x="210" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1c" label="NAT Gateway" added="1" derived="Resources in a private subnet can connect to the internet through a NAT device in a public subnet, which replaces their source IPv4 addresses with its own. | You can use the managed NAT device AWS offers, the NAT gateway, or build your own NAT device on EC2, a NAT instance; AWS recommends NAT gateways for better availability and bandwidth and less administration. archwire draws a NAT gateway. | One NAT gateway per Availability Zone keeps outbound traffic working when another zone fails." rule="private-egress-through-nat | nat-device-is-nat-gateway | nat-per-az" kind="constraint | default | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1c"><mxGeometry x="210" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1a" label="Amazon ECS (Fargate)" derived="No subnet was given, so ECS is placed in private subnets; traffic reaches it through the load balancer." rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate" vertex="1" parent="pri-1a"><mxGeometry x="90" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="ecs-1c" label="Amazon ECS (Fargate)" derived="No subnet was given, so ECS is placed in private subnets; traffic reaches it through the load balancer." rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate" vertex="1" parent="pri-1c"><mxGeometry x="90" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1a" label="Amazon Aurora&#xa;Writer" derived="No subnet was given, so Aurora is placed in private subnets so it is not reachable from the internet. | The Writer goes in the first Availability Zone and Readers in the remaining ones." rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1a"><mxGeometry x="90" y="260" width="60" height="60" as="geometry" /></mxCell></object>
