<mxfile archwire="0.1.0" rules="2026.11.14"><diagram id="p1" name="Architecture"><mxGraphModel adaptiveColors="auto"><root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS resources are drawn inside the AWS Cloud frame." rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="160" y="60" width="1138" height="584" as="geometry" /></mxCell></object>
<object id="region" label="Tokyo (ap-northeast-1)" added="1" derived="AWS resources that belong to a Region are drawn inside that Region's frame. | No Region was given, so ap-northeast-1 (Tokyo) is used." rule="resources-inside-region-frame | default-region" kind="default | default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="422" y="50" width="686" height="504" as="geometry" /></mxCell></object>
<object id="user" label="Users"><mxCell style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users" vertex="1" parent="1"><mxGeometry x="40" y="250" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudfront" label="Amazon CloudFront" derived="AWS lists Amazon CloudFront, Amazon Route 53 and AWS WAF for CloudFront among the global services, whose resources are not Region-specific. archwire draws global services inside the AWS Cloud frame and outside the Region frame." rule="global-service-outside-region" kind="default" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront" vertex="1" parent="aws-cloud"><mxGeometry x="80" y="110" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3" label="Amazon S3" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame." rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="110" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="apigateway" label="Amazon API Gateway&#xa;REST API" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame. | To integrate a REST API with an Amazon Cognito user pool, a COGNITO_USER_POOLS authorizer that uses the user pool is created in API Gateway. archwire draws the association as that authorizer." rule="regional-service-outside-vpc | rest-api-cognito-authorizer" kind="default | default" source=" | https://docs.aws.amazon.com/apigateway/latest/developerguide/apigateway-enable-cognito-user-pool.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway" vertex="1" parent="region"><mxGeometry x="110" y="220" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda" label="AWS Lambda" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame." rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="region"><mxGeometry x="330" y="220" width="60" height="60" as="geometry" /></mxCell></object>
<object id="dynamodb" label="Amazon DynamoDB" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame." rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb" vertex="1" parent="region"><mxGeometry x="550" y="220" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cognito" label="Amazon Cognito" derived="Amazon Cognito user pools are each created in one AWS Region. archwire draws the user pool inside the Region frame." rule="cognito-user-pool-in-one-region" kind="constraint" source="https://docs.aws.amazon.com/cognito/latest/developerguide/security-cognito-regional-data-considerations.html"><mxCell style="fontColor=#16191F;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito" vertex="1" parent="region"><mxGeometry x="110" y="380" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudwatch" label="Amazon CloudWatch" derived="Regional services that are not placed in a VPC subnet are drawn inside the Region frame and outside the VPC frame." rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2" vertex="1" parent="region"><mxGeometry x="330" y="380" width="60" height="60" as="geometry" /></mxCell></object>
<object id="waf" label="AWS WAF" derived="AWS lists Amazon CloudFront, Amazon Route 53 and AWS WAF for CloudFront among the global services, whose resources are not Region-specific. archwire draws global services inside the AWS Cloud frame and outside the Region frame." rule="global-service-outside-region" kind="default" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf" vertex="1" parent="aws-cloud"><mxGeometry x="80" y="270" width="60" height="60" as="geometry" /></mxCell></object>
<object id="acm" label="AWS Certificate Manager&#xa;us-east-1" derived="To use an AWS Certificate Manager certificate with a CloudFront distribution, the certificate is requested or imported in US East (N. Virginia) (us-east-1). archwire draws it outside the Region frame and writes us-east-1 under its name." rule="cloudfront-certificate-in-us-east-1" kind="constraint" source="https://docs.aws.amazon.com/AmazonCloudFront/latest/DeveloperGuide/cnames-and-https-requirements.html"><mxCell style="fontColor=#16191F;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3" vertex="1" parent="aws-cloud"><mxGeometry x="240" y="270" width="60" height="60" as="geometry" /></mxCell></object>
