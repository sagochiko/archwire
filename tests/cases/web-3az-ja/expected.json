      "source": "https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat-gateway.html"
    },
    {
      "target": "nat-1c",
      "added": true,
      "kind": "constraint",
      "rule": "private-egress-through-nat",
      "reason": "プライベートサブネットのリソースは、パブリックサブネットに作った NAT Gateway を通してインターネットへ接続する。",
      "source": "https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat-gateway.html"
    },
    {
      "target": "nat-1d",
      "added": true,
      "kind": "constraint",
      "rule": "private-egress-through-nat",
      "reason": "プライベートサブネットのリソースは、パブリックサブネットに作った NAT Gateway を通してインターネットへ接続する。",
      "source": "https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat-gateway.html"
    },
    {
      "target": "nat",
      "added": true,
      "kind": "default",
      "rule": "nat-per-az",
      "reason": "NAT Gateway をアベイラビリティゾーンごとに置くと、ほかのゾーンが止まっても外向きの通信が続く。",
      "source": "https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"
    }
