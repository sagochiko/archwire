<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS のリソースは AWS Cloud の枠の中に描く。" rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="40" y="177" width="1251" height="1174" as="geometry" /></mxCell></object>
<object id="region" label="東京リージョン（ap-northeast-1）" added="1" derived="リージョンに属する AWS のリソースは、そのリージョンの枠の中に描く。 | リージョンの指定が無いので、ap-northeast-1（東京）にする。" rule="resources-inside-region-frame | default-region" kind="default | default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="30" y="50" width="1191" height="1094" as="geometry" /></mxCell></object>
<object id="vpc" label="VPC" added="1" derived="Amazon Aurora の DB クラスターは VPC の中にだけ作成できるので、VPC を描く。" rule="aurora-cluster-in-vpc" kind="constraint" source="https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="region"><mxGeometry x="30" y="280" width="862" height="774" as="geometry" /></mxCell></object>
<object id="az-1a" label="ap-northeast-1a" added="1" derived="Aurora の DB クラスターに選ぶ DB サブネットグループは、少なくとも2つのアベイラビリティゾーンを覆わなければならない。archwire は、2つ以上のアベイラビリティゾーンを描く。 | AZ の数の指定が無いので、2つにする。" rule="aurora-subnet-group-two-azs | default-two-azs-for-database" kind="constraint | default" source="https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="30" y="157" width="391" height="597" as="geometry" /></mxCell></object>
<object id="pub-1a" label="パブリックサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="20" y="30" width="351" height="154" as="geometry" /></mxCell></object>
<object id="pri-1a" label="プライベートサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1a"><mxGeometry x="20" y="204" width="351" height="378" as="geometry" /></mxCell></object>
<object id="az-1c" label="ap-northeast-1c" added="1" derived="Aurora の DB クラスターに選ぶ DB サブネットグループは、少なくとも2つのアベイラビリティゾーンを覆わなければならない。archwire は、2つ以上のアベイラビリティゾーンを描く。 | AZ の数の指定が無いので、2つにする。" rule="aurora-subnet-group-two-azs | default-two-azs-for-database" kind="constraint | default" source="https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/Aurora.CreateInstance.html | "><mxCell style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#000000;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="vpc"><mxGeometry x="441" y="157" width="391" height="597" as="geometry" /></mxCell></object>
<object id="pub-1c" label="パブリックサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="20" y="30" width="351" height="154" as="geometry" /></mxCell></object>
<object id="pri-1c" label="プライベートサブネット" added="1" derived="archwire は、各アベイラビリティゾーンにパブリックサブネットとプライベートサブネットを1つずつ置く。" rule="public-and-private-subnet-per-az" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="az-1c"><mxGeometry x="20" y="204" width="351" height="378" as="geometry" /></mxCell></object>
<object id="user" label="利用者"><mxCell style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users" vertex="1" parent="1"><mxGeometry x="497" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="igw" label="Internet Gateway" added="1" derived="プライベートサブネットのリソースは、パブリックサブネットに置いた NAT デバイスを通じてインターネットへ接続できる。NAT デバイスは、送信元の IPv4 アドレスを自分のアドレスに置きかえる。" rule="private-egress-through-nat" kind="constraint" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.internet_gateway" vertex="1" parent="vpc"><mxGeometry x="401" y="33" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1a" label="NAT Gateway" added="1" derived="プライベートサブネットのリソースは、パブリックサブネットに置いた NAT デバイスを通じてインターネットへ接続できる。NAT デバイスは、送信元の IPv4 アドレスを自分のアドレスに置きかえる。 | AWS が提供するマネージドな NAT デバイスである NAT ゲートウェイを使うことも、EC2 インスタンス上に自分で NAT デバイス（NAT インスタンス）を作ることもできる。AWS は、可用性と帯域幅が優れ管理の手間が少ない NAT ゲートウェイを推奨している。archwire は NAT ゲートウェイを描く。 | NAT Gateway をアベイラビリティゾーンごとに置くと、ほかのゾーンが止まっても外向きの通信が続く。" rule="private-egress-through-nat | nat-device-is-nat-gateway | nat-per-az" kind="constraint | default | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1a"><mxGeometry x="261" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="nat-1c" label="NAT Gateway" added="1" derived="プライベートサブネットのリソースは、パブリックサブネットに置いた NAT デバイスを通じてインターネットへ接続できる。NAT デバイスは、送信元の IPv4 アドレスを自分のアドレスに置きかえる。 | AWS が提供するマネージドな NAT デバイスである NAT ゲートウェイを使うことも、EC2 インスタンス上に自分で NAT デバイス（NAT インスタンス）を作ることもできる。AWS は、可用性と帯域幅が優れ管理の手間が少ない NAT ゲートウェイを推奨している。archwire は NAT ゲートウェイを描く。 | NAT Gateway をアベイラビリティゾーンごとに置くと、ほかのゾーンが止まっても外向きの通信が続く。" rule="private-egress-through-nat | nat-device-is-nat-gateway | nat-per-az" kind="constraint | default | default" source="https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/vpc-nat.html | https://docs.aws.amazon.com/vpc/latest/userguide/nat-gateway-scenarios.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.nat_gateway" vertex="1" parent="pub-1c"><mxGeometry x="261" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda-1a" label="AWS Lambda" derived="Lambda 関数は、リソースを含むプライベートサブネットを通じて VPC にアタッチすると、Amazon VPC 内のリソースにアクセスできる。archwire は、VPC の中の部品につなぐ関数を、その VPC のプライベートサブネットに描く。 | Lambda 関数はどれも、Lambda が所有し管理する VPC の中で動く。関数を VPC にアタッチすると、選んだサブネットとセキュリティグループの組み合わせに対して Lambda が作るネットワークインターフェイスを使う。archwire は、アタッチした関数を、各アベイラビリティゾーンのプライベートサブネットに1つずつ描く。 | VPC にアタッチした関数は、VPC にインターネットアクセスが無ければ、その VPC 内のリソースにしか届かない。IPv4 では、プライベートサブネットは NAT ゲートウェイを通じてインターネットにアクセスできる。archwire は、アタッチした関数の IPv4 でのインターネットアクセスのために、パブリックサブネットに NAT ゲートウェイを足す。" rule="function-attaches-to-resource-vpc | attached-function-per-az | attached-function-internet-through-nat" kind="constraint | default | constraint" source="https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc-internet.html"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="pri-1a"><mxGeometry x="141" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda-1c" label="AWS Lambda" derived="Lambda 関数は、リソースを含むプライベートサブネットを通じて VPC にアタッチすると、Amazon VPC 内のリソースにアクセスできる。archwire は、VPC の中の部品につなぐ関数を、その VPC のプライベートサブネットに描く。 | Lambda 関数はどれも、Lambda が所有し管理する VPC の中で動く。関数を VPC にアタッチすると、選んだサブネットとセキュリティグループの組み合わせに対して Lambda が作るネットワークインターフェイスを使う。archwire は、アタッチした関数を、各アベイラビリティゾーンのプライベートサブネットに1つずつ描く。 | VPC にアタッチした関数は、VPC にインターネットアクセスが無ければ、その VPC 内のリソースにしか届かない。IPv4 では、プライベートサブネットは NAT ゲートウェイを通じてインターネットにアクセスできる。archwire は、アタッチした関数の IPv4 でのインターネットアクセスのために、パブリックサブネットに NAT ゲートウェイを足す。" rule="function-attaches-to-resource-vpc | attached-function-per-az | attached-function-internet-through-nat" kind="constraint | default | constraint" source="https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html | https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc-internet.html"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="pri-1c"><mxGeometry x="141" y="50" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1a" label="Amazon Aurora&#xa;Writer" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1a"><mxGeometry x="141" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="aurora-1c" label="Amazon Aurora&#xa;Reader" derived="サブネットの指定が無いので、Aurora はインターネットから届かないプライベートサブネットに置く。 | Writer を1つ目の AZ に、Reader を残りの AZ に置く。" rule="database-in-private | aurora-writer-reader" kind="default | default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora" vertex="1" parent="pri-1c"><mxGeometry x="141" y="260" width="60" height="60" as="geometry" /></mxCell></object>
<object id="apigateway" label="Amazon API Gateway&#xa;HTTP API" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway" vertex="1" parent="region"><mxGeometry x="427" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3" label="Amazon S3" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="1052" y="691" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudwatch" label="Amazon CloudWatch" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2" vertex="1" parent="region"><mxGeometry x="1052" y="851" width="60" height="60" as="geometry" /></mxCell></object>
