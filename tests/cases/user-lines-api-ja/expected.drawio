<object id="aws-cloud" label="AWS Cloud" added="1" derived="AWS のリソースは AWS Cloud の枠の中に描く。" rule="resources-inside-aws-cloud-frame" kind="default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="40" y="177" width="1571" height="776" as="geometry" /></mxCell></object>
<object id="region" label="東京リージョン（ap-northeast-1）" added="1" derived="リージョンに属する AWS のリソースは、そのリージョンの枠の中に描く。 | リージョンの指定が無いので、ap-northeast-1（東京）にする。" rule="resources-inside-region-frame | default-region" kind="default | default"><mxCell style="html=1;whiteSpace=wrap;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=1;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="aws-cloud"><mxGeometry x="30" y="182" width="1487" height="564" as="geometry" /></mxCell></object>
<object id="user" label="利用者"><mxCell style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users" vertex="1" parent="1"><mxGeometry x="862" y="40" width="60" height="60" as="geometry" /></mxCell></object>
<object id="apigateway" label="Amazon API Gateway&#xa;HTTP API" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway" vertex="1" parent="region"><mxGeometry x="210" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="lambda" label="AWS Lambda" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda" vertex="1" parent="region"><mxGeometry x="210" y="280" width="60" height="60" as="geometry" /></mxCell></object>
<object id="dynamodb" label="Amazon DynamoDB" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#C925D1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb" vertex="1" parent="region"><mxGeometry x="210" y="440" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cognito" label="Amazon Cognito" derived="Amazon Cognito のユーザープールは、それぞれ1つの AWS リージョンに作られる。archwire はユーザープールをリージョンの枠の中に描く。" rule="cognito-user-pool-in-one-region" kind="constraint" source="https://docs.aws.amazon.com/cognito/latest/developerguide/security-cognito-regional-data-considerations.html"><mxCell style="fontColor=#16191F;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito" vertex="1" parent="region"><mxGeometry x="443" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3.uploads" label="Amazon S3&#xa;uploads" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="676" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="athena" label="Amazon Athena" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena" vertex="1" parent="region"><mxGeometry x="909" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="s3.logs" label="Amazon S3&#xa;logs" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3" vertex="1" parent="region"><mxGeometry x="1025" y="280" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudtrail" label="AWS CloudTrail" derived="VPC のサブネットに置かないリージョンのサービスは、リージョンの枠の中、VPC の枠の外に描く。" rule="regional-service-outside-vpc" kind="default"><mxCell style="fontColor=#16191F;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail" vertex="1" parent="region"><mxGeometry x="1142" y="60" width="60" height="60" as="geometry" /></mxCell></object>
<object id="cloudfront" label="Amazon CloudFront" derived="AWS は Amazon CloudFront、Amazon Route 53、AWS WAF for CloudFront を、リソースがリージョンに属さないグローバルサービスに挙げている。archwire はグローバルサービスを AWS Cloud の枠の中、リージョンの枠の外に描く。" rule="global-service-outside-region" kind="default" source="https://docs.aws.amazon.com/whitepapers/latest/aws-fault-isolation-boundaries/global-services.html"><mxCell style="fontColor=#16191F;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront" vertex="1" parent="aws-cloud"><mxGeometry x="1405" y="45" width="60" height="60" as="geometry" /></mxCell></object>
