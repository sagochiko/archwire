<object id="ecs.web@1a" label="Amazon ECS&#xa;web" derived="サブネットの指定が無いので、ECS はプライベートサブネットに置く。外からの通信はロードバランサーが受ける。" rule="compute-in-private" kind="default"><mxCell style="fontColor=#16191F;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs" vertex="1" parent="pri-1a"><mxGeometry x="141" y="50" width="60" height="60" as="geometry" /></mxCell></object>
